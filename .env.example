# Comma-separated pool (GEMINI_API_KEY_1..N is also accepted as a fallback)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash-lite
AUTH_ENABLED=false
DEVICE_TOKENS=dev-token-1
ADMIN_TOKEN=admin-token
ORG_SALT=change-me
POLICY_PATH=policy/policy.yaml
LEXICON_PATH=policy/lexicon.yaml
DB_PATH=./data/kavach.db
LLM_CACHE_DIR=./data/cache
MINUTES_PER_ALERT=2
COMMAND_REDELIVERY_SEC=60
# Optional LangSmith tracing of Gemini calls (masked text only; OCR = metadata only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kavach-server
